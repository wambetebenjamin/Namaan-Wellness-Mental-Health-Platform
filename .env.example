# =============================================================================
# NAAMAN WELLNESS — ENVIRONMENT VARIABLES
# Copy to .env.local and fill in. NEVER commit real secrets.
# Every secret used by this project is declared here.
# =============================================================================

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Canonical public origin, used for absolute URLs in emails, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.naamanwellness.co.ke
NEXT_PUBLIC_SITE_NAME=Naaman Wellness

# -----------------------------------------------------------------------------
# CAPTCHA — reCAPTCHA v3 (invisible). Server secret MUST stay server-side.
# -----------------------------------------------------------------------------
# Server-side verification secret. Required. Server only.
RECAPTCHA_SECRET_KEY=
# Public site key, rendered into the client widget. Safe to expose.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# reCAPTCHA v2 (checkbox) fallback site key, used when the v3 score < threshold.
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=
# reCAPTCHA v2 (checkbox) fallback secret. Server only.
RECAPTCHA_V2_SECRET_KEY=
# Score at or above which a v3 token is accepted. Below this, v2 is shown.
RECAPTCHA_MIN_SCORE=0.5
# Bypass verification in local development only. Never enable in production.
CAPTCHA_DEV_BYPASS=false

# -----------------------------------------------------------------------------
# Vercel KV — bookings, availability, newsletter subscribers
# -----------------------------------------------------------------------------
# Automatically injected by Vercel when a KV store is linked to the project.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# -----------------------------------------------------------------------------
# Email — Nodemailer (booking confirmations, corporate + contact notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# "From" address for outbound mail.
MAIL_FROM=Naaman Wellness <hello@naamanwellness.co.ke>
# Where general contact-form and corporate enquiries are delivered.
MAIL_TO_CLINIC=hello@naamanwellness.co.ke
# Support address shown on the 500 page.
NEXT_PUBLIC_SUPPORT_EMAIL=hello@naamanwellness.co.ke

# -----------------------------------------------------------------------------
# WhatsApp — non-emergency enquiries and booking notifications
# -----------------------------------------------------------------------------
# Client-facing wa.me number (non-emergency). Public, shown in the UI.
NEXT_PUBLIC_WHATSAPP_NUMBER=254112272061
# WhatsApp Cloud API access token for outbound booking notifications. Server only.
WHATSAPP_TOKEN=
# WhatsApp Cloud API phone number ID. Server only.
WHATSAPP_PHONE_NUMBER_ID=
# Destination number for internal booking notifications (clinic line).
WHATSAPP_NOTIFY_NUMBER=254112272061

# -----------------------------------------------------------------------------
# Crisis line — Befrienders Kenya. Public, displayed on every page.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CRISIS_LINE_NAME=Befrienders Kenya
NEXT_PUBLIC_CRISIS_LINE_NUMBER=0800 723 253
NEXT_PUBLIC_CRISIS_LINE_TEL=+254800723253
